<div class="dashboard-container">
  <h1 class="dashboard-title">Mon Tableau de Bord 📊</h1>

  <div class="cards-grid">
    <div class="card">
      <span class="card-label">Solde Total</span>
      <span class="card-value total">3100 €</span>
    </div>
    <div class="card">
      <span class="card-label">Revenus</span>
      <span class="card-value income">+ 4700 €</span>
    </div>
    <div class="card">
      <span class="card-label">Dépenses</span>
      <span class="card-value expense">- 1600 €</span>
    </div>
  </div>

  <div class="button-group">
    <button class="btn btn-income">Ajouter +100 € (Revenu)</button>
    <button class="btn btn-expense">Ajouter +50 € (Dépense)</button>
  </div>
</div>